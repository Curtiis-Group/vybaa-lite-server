# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
POSTGRES_USER=vybaa
POSTGRES_PASSWORD=vybaa_password
POSTGRES_DB=vybaa_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vybaa:vybaa_password@localhost:5432/vybaa_db?schema=public

# JWT Secrets
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_change_in_production

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here

# Sign in with Apple (native iOS bundle ID; defaults to com.vybaa.app)
APPLE_CLIENT_ID=com.vybaa.app

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# My Cove Firebase Configuration
# Use a separate Firebase project and OAuth client for the My Cove surface.
MYCOVE_GOOGLE_CLIENT_ID=your_mycove_google_oauth_client_id
MYCOVE_FIREBASE_PROJECT_ID=your_mycove_firebase_project_id
MYCOVE_FIREBASE_PRIVATE_KEY=your_mycove_firebase_private_key
MYCOVE_FIREBASE_CLIENT_EMAIL=your_mycove_firebase_client_email

# First-party realtime fan-out across API instances
REDIS_URL=redis://localhost:6379
REALTIME_MAX_CONNECTIONS_PER_USER=4
REWIND_ASYNC_CHAT_ENABLED=true
REWIND_AUTONOMOUS_CHAT_ENABLED=true

# SMTP / Email
SMTP_USER="vybaa.app@gmail.com"
SMTP_PASSWORD="jsus dsjds sdjds dsjs"
APP_NAME="name"
MODERATION_ALERT_EMAIL="safety@vybaa.app"

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_REWIND_ANALYSIS_MODEL=gemini-3.5-flash
# USD per million tokens used for the AI usage ledger (update when provider rates change)
GEMINI_INPUT_USD_PER_MILLION=0.75
GEMINI_OUTPUT_USD_PER_MILLION=3.75
REWIND_MESSAGE_RATE_LIMIT=200

# Rewind live voice provider: GEMINI or ELEVENLABS
REWIND_LIVE_VOICE_PROVIDER=GEMINI
# Required only when REWIND_LIVE_VOICE_PROVIDER=ELEVENLABS
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id
# Voice IDs are optional. Missing entries use Vybaa's tuned persona defaults.
ELEVENLABS_VOICE_ELLA=
ELEVENLABS_VOICE_LYRA=
ELEVENLABS_VOICE_JAKE=
ELEVENLABS_VOICE_ARIEL=
ELEVENLABS_VOICE_TOBI=
ELEVENLABS_VOICE_NEEJA=

# RevenueCat server-side verification
REVENUECAT_REST_API_KEY=your_vybaa_revenuecat_secret_key
# Required when REVENUECAT_REST_API_KEY is a RevenueCat API v2 key.
REVENUECAT_PROJECT_ID=your_vybaa_revenuecat_project_id
REVENUECAT_ENTITLEMENT_ID=vybaa_pro
# HMAC signing secret for POST /api/v1/webhooks/revenuecat
REVENUECAT_WEBHOOK_SECRET=your_vybaa_webhook_signing_secret
MYCOVE_REVENUECAT_REST_API_KEY=your_mycove_revenuecat_secret_key
MYCOVE_REVENUECAT_PROJECT_ID=your_mycove_revenuecat_project_id
MYCOVE_REVENUECAT_ENTITLEMENT_ID=My Cove Pro
# HMAC signing secret for POST /mycove/v1/webhooks/revenuecat
MYCOVE_REVENUECAT_WEBHOOK_SECRET=your_mycove_webhook_signing_secret


ADMIN_SECRET=super-secret-phrase
