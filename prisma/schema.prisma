// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  email    String  @unique
  password String? // Nullable for OAuth users

  // User bio/profile fields
  firstName            String?   @map("first_name")
  lastName             String?   @map("last_name")
  username             String?   @unique // Required - auto-generated on signup
  avatarUrl            String?   @map("avatar_url")
  currentMood          String?   @map("current_mood")
  rewindPersona        String?   @map("rewind_persona")
  timezone             String    @default("UTC") @map("timezone")
  lastUsernameChangeAt DateTime? @map("last_username_change_at") // Track username changes for cooldown

  // Auth fields
  isConfirmed Boolean @default(false) @map("is_confirmed")
  isFirstTime Boolean @default(true) @map("is_first_time")

  // OAuth fields
  googleId String? @unique @map("google_id")

  // Play Wallet (existing)
  points Float? @default(0)

  // Main Wallet (real points / currency-like balance)
  realPointsBalance Int @default(0) @map("real_points_balance")

  refreshToken String?  @map("refresh_token")
  fcmTokens    String[] @default([]) @map("fcm_tokens") // Legacy Vybaa device tokens

  role String @default("USER") // USER, ADMIN

  // OTP fields (for password reset and account confirmation)
  otpCode      String?   @map("otp_code")
  otpExpiresAt DateTime? @map("otp_expires_at")

  // Relations
  goals         Goal[]
  notifications Notification[]
  achievements  Achievement[]
  chillSessions ChillSession[]
  journals      Journal[]
  fcmDevices    FcmDevice[]

  // Community relations
  ownedCommunities     Community[]         @relation("CommunityOwner")
  communityMemberships CommunityMember[]
  createdTemplates     GoalTemplate[]      @relation("TemplateCreator")
  communityActivities  CommunityActivity[]
  activityReactions    ActivityReaction[]
  activityComments     ActivityComment[]
  createdInvites       CommunityInvite[]   @relation("InviteCreator")
  receivedInvites      CommunityInvite[]   @relation("InviteRecipient")
  rewindSessions       RewindSession[]
  rewindRoutine        RewindRoutine?
  subscriptionSnapshots SubscriptionSnapshot[]

  // Summary caching
  lastEmotionSummaryAt DateTime? @map("last_emotion_summary_at") // Last time AI summary was generated
  emotionSummary       String?   @map("emotion_summary") // Cached AI-generated summary
  lastJournalSummaryAt DateTime? @map("last_journal_summary_at") // Last time journal summary was generated
  journalSummary       String?   @map("journal_summary") // Cached journal summary

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  sentTransactions     Transaction[] @relation("TransactionSender")
  receivedTransactions Transaction[] @relation("TransactionRecipient")
}

enum ClientApp {
  VYBAA
  MYCOVE
}

enum RevenueCatWebhookStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  FAILED
}

model FcmDevice {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  clientApp ClientApp @map("client_app")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([clientApp, token])
  @@index([userId, clientApp])
  @@map("fcm_devices")
}

model SubscriptionSnapshot {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientApp         ClientApp @map("client_app")
  entitlementId     String    @map("entitlement_id")
  isPro             Boolean   @default(false) @map("is_pro")
  productIdentifier String?   @map("product_identifier")
  periodType        String?   @map("period_type")
  environment       String?
  expiresAt         DateTime? @map("expires_at")
  managementUrl     String?   @map("management_url")
  verifiedAt        DateTime  @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, clientApp])
  @@index([clientApp, isPro, expiresAt])
  @@map("subscription_snapshots")
}

model RevenueCatWebhookEvent {
  id String @id @default(cuid())

  externalEventId String                  @map("external_event_id")
  clientApp       ClientApp               @map("client_app")
  eventType       String                  @map("event_type")
  appUserId       String?                 @map("app_user_id")
  rawPayload      String                  @map("raw_payload") @db.Text
  status          RevenueCatWebhookStatus @default(RECEIVED)
  attemptCount    Int                     @default(0) @map("attempt_count")
  lastError       String?                 @map("last_error")
  nextAttemptAt   DateTime?               @map("next_attempt_at")
  processedAt     DateTime?               @map("processed_at")
  receivedAt      DateTime                @default(now()) @map("received_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @default(now()) @updatedAt @map("updated_at")

  @@unique([clientApp, externalEventId])
  @@index([status, nextAttemptAt])
  @@map("revenuecat_webhook_events")
}

model RewindSession {
  id String @id

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  personaId            String    @map("persona_id")
  sessionDateKey       String?   @map("session_date_key")
  timezone             String?   @map("timezone")
  scheduledFor         DateTime? @map("scheduled_for")
  windowEndsAt         DateTime? @map("window_ends_at")
  startedAt            DateTime? @map("started_at")
  status               RewindSessionStatus @default(LEGACY)
  completionSource     RewindCompletionSource? @map("completion_source")
  openingAnswered      Boolean?  @default(false) @map("opening_answered")
  currentQuestionIndex Int?      @default(0) @map("current_question_index")
  completed            Boolean   @default(false)
  completedAt          DateTime? @map("completed_at")
  checkInAt            DateTime? @map("check_in_at")
  responses            Json?
  summary              String?
  emotionalInsight     String?   @map("emotional_insight")
  emotionalTags        String[]  @default([]) @map("emotional_tags")
  nextStepNote         String?   @map("next_step_note")
  comparisonInsight    String?   @map("comparison_insight")
  journalDraft         String?   @map("journal_draft")
  wellbeingSignals     Json?     @map("wellbeing_signals")
  transcriptAvailable  Boolean   @default(false) @map("transcript_available")
  journalId            String?   @map("journal_id")
  journalSavedAt       DateTime? @map("journal_saved_at")
  journal              Journal?  @relation(fields: [journalId], references: [id], onDelete: SetNull)
  turns                RewindTurn[]

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, scheduledFor])
  @@index([userId, personaId, updatedAt])
  @@index([userId, completed, sessionDateKey])
  @@index([status, windowEndsAt])
  @@index([journalId])
  @@map("rewind_sessions")
}

model RewindRoutine {
  id String @id @default(cuid())

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  frequency    RewindFrequency
  times        String[]        @default([])
  intent       RewindIntent
  customIntent String?         @map("custom_intent") @db.Text
  enabled      Boolean         @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("rewind_routines")
}

enum RewindFrequency {
  MORNINGS_AND_EVENINGS
  JUST_MORNINGS
  JUST_EVENINGS
  CUSTOM
}

enum RewindIntent {
  UNDERSTAND_EMOTIONS
  SPOT_PATTERNS
  BUILD_SMALL_CHANGES
  CUSTOM
}

enum RewindSessionStatus {
  LEGACY
  SCHEDULED
  IN_PROGRESS
  FINALIZING
  COMPLETED
  MISSED
}

enum RewindCompletionSource {
  USER
  AUTO_TIMEOUT
}

enum RewindTurnRole {
  USER
  PARTNER
}

model RewindTurn {
  id String @id @default(cuid())

  sessionId String        @map("session_id")
  session   RewindSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  sequence Int            @map("sequence")
  role     RewindTurnRole
  content  String         @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([sessionId, sequence])
  @@index([sessionId, createdAt])
  @@map("rewind_turns")
}

model FeatureFlag {
  id String @id @default(cuid())

  key     String  @unique
  enabled Boolean @default(false)

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("feature_flags")
}

model Goal {
  id String @id @default(cuid())

  goalText        String    @map("goal_text")
  targetDays      Int       @map("target_days")
  currentDay      Int       @default(0) @map("current_day")
  lastCheckInDate DateTime? @map("last_check_in_date")
  reminderTime    String?   @map("reminder_time") // Format: "HH:MM" (24-hour format)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  // Community relations
  templateId  String?       @map("template_id")
  template    GoalTemplate? @relation(fields: [templateId], references: [id])
  communityId String?       @map("community_id")
  community   Community?    @relation(fields: [communityId], references: [id])

  checkIns      CheckIn[]
  pendingPoints GoalPendingPoints?

  startedAt         DateTime           @map("started_at")
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  goalMilestoneHits GoalMilestoneHit[]

  @@index([templateId])
  @@index([communityId])
}

model CheckIn {
  id String @id @default(cuid())

  goalId String @map("goal_id")
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  checkInDate DateTime @map("check_in_date")
  notes       String?  @db.Text // Optional notes for the check-in
  attachments String? // JSON array of attachments: [{type: 'image'|'audio', url: string, publicId?: string, name?: string}]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([goalId, checkInDate])
  @@map("check_ins")
}

model Notification {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goalId String? @map("goal_id")

  type    String // "goal_reminder", "goal_completed", "streak_milestone", "system"
  title   String
  message String
  data    String? // JSON string for additional data
  dedupeKey String? @map("dedupe_key")

  isRead Boolean @default(false) @map("is_read")

  scheduledFor DateTime? @map("scheduled_for") // When the notification should be sent
  sentAt       DateTime? @map("sent_at") // When the notification was actually sent
  dispatchToken String? @map("dispatch_token")
  dispatchingAt  DateTime? @map("dispatching_at")
  deliveryAttempts Int @default(0) @map("delivery_attempts")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([scheduledFor])
  @@index([dispatchToken])
  @@index([sentAt, scheduledFor, dispatchingAt])
  @@unique([userId, dedupeKey])
  @@map("notifications")
}

model Achievement {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goalId String? @map("goal_id")

  type        String // "streak_milestone", "goal_completed", "total_goals", "total_checkins", "perfect_week", "comeback", "early_bird"
  milestone   Int // Day number or count (3, 7, 14, 21, 30, 50, 100, 365)
  title       String // "Adventurous Streaker", "Consistency Champion"
  description String // "Reached 10 consecutive days"
  badgeIcon   String @map("badge_icon") // Emoji or icon identifier

  earnedAt DateTime @default(now()) @map("earned_at")

  @@unique([userId, type, milestone])
  @@index([userId])
  @@map("achievements")
}

model ChillSession {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emotion         String // User's emotional input
  duration        Int // Session duration in minutes
  completed       Boolean   @default(false)
  completedAt     DateTime? @map("completed_at")
  postSessionMood String?   @map("post_session_mood") // How user felt after session

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([completed, completedAt])
  @@map("chill_sessions")
}

model Journal {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date    DateTime // Date of the journal entry (date only, no time)
  content String   @db.Text // Journal entry text
  mood    String? // Mood/emotion tag (e.g., "happy", "anxious", "calm")
  tags    String[] @default([]) // Additional tags
  rewindSessions RewindSession[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@index([userId, date])
  @@map("journals")
}

enum CommunityMemberRole {
  OWNER
  MOD
  MEMBER
}

enum CommunityActivityType {
  GOAL_STARTED
  GOAL_CHECK_IN
  GOAL_COMPLETED
  GOAL_STREAK_RESET
  GOAL_DELETED
  MEMBER_LEFT
  MILESTONE_REACHED
  ACHIEVEMENT_EARNED
  TEMPLATE_CREATED
}

model Community {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  coverImage  String? @map("cover_image")
  isPublic    Boolean @default(false) @map("is_public") // Communities are invite-only by default
  category    String?

  ownerId String @map("owner_id")
  owner   User   @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members    CommunityMember[]
  templates  GoalTemplate[]
  activities CommunityActivity[]
  goals      Goal[]
  invites    CommunityInvite[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([isPublic, createdAt])
  @@map("communities")
}

model CommunityInvite {
  id          String    @id @default(cuid())
  communityId String    @map("community_id")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  code      String @unique // Short shareable code e.g. "A3K9F2"
  createdBy String @map("created_by")
  creator   User   @relation("InviteCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  // For targeted invites
  inviteeEmail    String? @map("invitee_email")
  inviteeUsername String? @map("invitee_username")
  inviteeUserId   String? @map("invitee_user_id")
  invitee         User?   @relation("InviteRecipient", fields: [inviteeUserId], references: [id], onDelete: SetNull)

  maxUses   Int       @default(-1) @map("max_uses") // -1 = unlimited
  uses      Int       @default(0)
  expiresAt DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([communityId])
  @@index([code])
  @@index([inviteeUserId])
  @@map("community_invites")
}

model CommunityMember {
  id          String    @id @default(cuid())
  communityId String    @map("community_id")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  role CommunityMemberRole @default(MEMBER)

  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([communityId, userId])
  @@index([userId])
  @@index([communityId])
  @@map("community_members")
}

model GoalTemplate {
  id          String    @id @default(cuid())
  communityId String    @map("community_id")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  goalText     String? @map("goal_text") // Aligned with Goal model
  targetDays   Int     @map("target_days")
  reminderTime String? @map("reminder_time") // Format: "HH:MM" (24-hour format)

  createdBy String @map("created_by")
  creator   User   @relation("TemplateCreator", fields: [createdBy], references: [id])

  startedGoals Goal[]
  milestones   TemplateMilestone[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([communityId])
  @@index([createdBy])
  @@map("goal_templates")
}

enum MilestoneTriggerType {
  DAY
  PERCENTAGE
  SEQUENCE
}

model TemplateMilestone {
  id                  String               @id @default(cuid())
  templateId          String               @map("template_id")
  template            GoalTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  triggerType         MilestoneTriggerType @map("trigger_type")
  triggerValue        Int                  @map("trigger_value")
  points              Float                @default(0)
  sequenceBonusPoints Float                @default(10) @map("sequence_bonus_points")
  sequenceStartDay    Int?                 @map("sequence_start_day")
  sequenceEndDay      Int?                 @map("sequence_end_day")
  order               Int                  @default(0)

  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at")
  goalMilestoneHits GoalMilestoneHit[]

  @@index([templateId, order])
  @@map("template_milestones")
}

model GoalMilestoneHit {
  id            String            @id @default(cuid())
  goalId        String            @map("goal_id")
  goal          Goal              @relation(fields: [goalId], references: [id], onDelete: Cascade)
  milestoneId   String            @map("milestone_id")
  milestone     TemplateMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  sequenceValue Int               @default(0) @map("sequence_value")
  pointsAwarded Float             @default(0) @map("points_awarded")
  awardedAt     DateTime          @default(now()) @map("awarded_at")

  @@unique([goalId, milestoneId, sequenceValue])
  @@index([goalId])
  @@index([milestoneId])
  @@map("goal_milestone_hits")
}

model CommunityActivity {
  id          String    @id @default(cuid())
  communityId String    @map("community_id")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     CommunityActivityType
  goalId   String?               @map("goal_id")
  metadata String?               @db.Text // JSON string for additional data

  reactions ActivityReaction[]
  comments  ActivityComment[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([communityId, createdAt])
  @@index([userId])
  @@index([goalId])
  @@map("community_activities")
}

model ServerMetric {
  id String @id @default(cuid())

  name  String
  tags  String[] @default([])
  value Float

  createdAt DateTime @default(now()) @map("created_at")

  @@index([name, createdAt])
  @@map("server_metrics")
}

model ActivityReaction {
  id         String            @id @default(cuid())
  activityId String            @map("activity_id")
  activity   CommunityActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String            @map("user_id")
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([activityId, userId])
  @@index([activityId])
  @@index([userId])
  @@map("activity_reactions")
}

model ActivityComment {
  id         String            @id @default(cuid())
  activityId String            @map("activity_id")
  activity   CommunityActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String            @map("user_id")
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  text String @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([activityId])
  @@index([userId])
  @@map("activity_comments")
}

model GoalPendingPoints {
  id     String @id @default(cuid())
  goalId String @unique @map("goal_id")
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  totalPendingPoints Float @default(0) @map("total_pending_points") // Sum of all milestone points earned but not yet released

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("goal_pending_points")
}

enum TransactionType {
  BUY_POINTS
  WITHDRAW_POINTS
  FEE_TRANSFER
  REWARD_POINTS
  MANUAL_ADJUSTMENT
}

model Transaction {
  id String @id @default(cuid())

  type       TransactionType
  amount     Float // Amount in points
  fiatAmount Float? // Optional: Amount in USD/Fiat

  senderId String? @map("sender_id")
  sender   User?   @relation("TransactionSender", fields: [senderId], references: [id])

  recipientId String @map("recipient_id")
  recipient   User   @relation("TransactionRecipient", fields: [recipientId], references: [id])

  referenceId String? @map("reference_id") // MoonPay transaction ID or Goal ID
  metadata    String? @db.Text // JSON string for additional details

  status String @default("PENDING") // PENDING, COMPLETED, FAILED

  createdAt DateTime @default(now()) @map("created_at")

  @@index([senderId])
  @@index([recipientId])
  @@index([type])
  @@map("transactions")
}

model SystemConfig {
  id String @id @default(cuid())

  key   String @unique
  value String

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_configs")
}
