// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  email    String  @unique
  password String? // Nullable for OAuth users

  // User bio/profile fields
  firstName                    String?   @map("first_name")
  lastName                     String?   @map("last_name")
  username                     String?   @unique // Required - auto-generated on signup
  avatarUrl                    String?   @map("avatar_url")
  currentMood                  String?   @map("current_mood")
  rewindPersona                String?   @map("rewind_persona")
  rewindPersonalizationEnabled Boolean   @default(true) @map("rewind_personalization_enabled")
  rewindProactiveChatEnabled   Boolean   @default(true) @map("rewind_proactive_chat_enabled")
  rewindProactiveChatExplainedAt DateTime? @map("rewind_proactive_chat_explained_at")
  timezone                     String    @default("UTC") @map("timezone")
  lastUsernameChangeAt         DateTime? @map("last_username_change_at") // Track username changes for cooldown

  // Auth fields
  isConfirmed Boolean @default(false) @map("is_confirmed")
  isFirstTime Boolean @default(true) @map("is_first_time")

  // OAuth fields
  googleId String? @unique @map("google_id")

  // Play Wallet (existing)
  points Float? @default(0)

  // Main Wallet (real points / currency-like balance)
  realPointsBalance Int @default(0) @map("real_points_balance")

  refreshToken String?  @map("refresh_token")
  fcmTokens    String[] @default([]) @map("fcm_tokens") // Legacy Vybaa device tokens

  role String @default("USER") // USER, ADMIN

  // OTP fields (for password reset and account confirmation)
  otpCode      String?   @map("otp_code")
  otpExpiresAt DateTime? @map("otp_expires_at")

  // Relations
  goals         Goal[]
  standardGoals GoalV2[]
  notifications Notification[]
  achievements  Achievement[]
  chillSessions ChillSession[]
  journals      Journal[]
  fcmDevices    FcmDevice[]

  // Community relations
  ownedCommunities      Community[]            @relation("CommunityOwner")
  communityMemberships  CommunityMember[]
  createdTemplates      GoalTemplate[]         @relation("TemplateCreator")
  communityActivities   CommunityActivity[]
  activityReactions     ActivityReaction[]
  activityComments      ActivityComment[]
  blockedUsers          UserBlock[]            @relation("UserBlocks")
  blockedByUsers        UserBlock[]            @relation("UserBlockedBy")
  reportsFiled          ContentReport[]        @relation("ReportsFiled")
  reportsAgainst        ContentReport[]        @relation("ReportsAgainst")
  createdInvites        CommunityInvite[]      @relation("InviteCreator")
  receivedInvites       CommunityInvite[]      @relation("InviteRecipient")
  rewindSessions        RewindSession[]
  rewindRecommendations RewindRecommendation[]
  rewindRoutine         RewindRoutine?
  rewindChats           RewindChat[]
  rewindChatMessages    RewindChatMessage[]
  rewindPartnerMinds    RewindPartnerMind[]
  rewindChatRuns        RewindChatRun[]
  rewindChatTurns       RewindChatTurn[]
  rewindChatOutbox      RewindChatOutbox[]
  aiUsageLedger         AiUsageLedger[]
  activitySignals       ActivitySignal[]
  dailyObservations     DailyObservation[]
  subscriptionSnapshots SubscriptionSnapshot[]

  // Summary caching
  lastEmotionSummaryAt DateTime? @map("last_emotion_summary_at") // Last time AI summary was generated
  emotionSummary       String?   @map("emotion_summary") // Cached AI-generated summary
  lastJournalSummaryAt DateTime? @map("last_journal_summary_at") // Last time journal summary was generated
  journalSummary       String?   @map("journal_summary") // Cached journal summary

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  sentTransactions     Transaction[] @relation("TransactionSender")
  receivedTransactions Transaction[] @relation("TransactionRecipient")
}

enum ClientApp {
  VYBAA
  MYCOVE
}

enum RevenueCatWebhookStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  FAILED
}

model FcmDevice {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  clientApp ClientApp @map("client_app")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([clientApp, token])
  @@index([userId, clientApp])
  @@map("fcm_devices")
}

model SubscriptionSnapshot {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientApp         ClientApp @map("client_app")
  entitlementId     String    @map("entitlement_id")
  isPro             Boolean   @default(false) @map("is_pro")
  productIdentifier String?   @map("product_identifier")
  periodType        String?   @map("period_type")
  environment       String?
  expiresAt         DateTime? @map("expires_at")
  managementUrl     String?   @map("management_url")
  verifiedAt        DateTime  @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, clientApp])
  @@index([clientApp, isPro, expiresAt])
  @@map("subscription_snapshots")
}

model RevenueCatWebhookEvent {
  id String @id @default(cuid())

  externalEventId String                  @map("external_event_id")
  clientApp       ClientApp               @map("client_app")
  eventType       String                  @map("event_type")
  appUserId       String?                 @map("app_user_id")
  rawPayload      String                  @map("raw_payload") @db.Text
  status          RevenueCatWebhookStatus @default(RECEIVED)
  attemptCount    Int                     @default(0) @map("attempt_count")
  lastError       String?                 @map("last_error")
  nextAttemptAt   DateTime?               @map("next_attempt_at")
  processedAt     DateTime?               @map("processed_at")
  receivedAt      DateTime                @default(now()) @map("received_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @default(now()) @updatedAt @map("updated_at")

  @@unique([clientApp, externalEventId])
  @@index([status, nextAttemptAt])
  @@map("revenuecat_webhook_events")
}

model RewindSession {
  id String @id

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  personaId            String                  @map("persona_id")
  sessionDateKey       String?                 @map("session_date_key")
  timezone             String?                 @map("timezone")
  scheduledFor         DateTime?               @map("scheduled_for")
  windowEndsAt         DateTime?               @map("window_ends_at")
  startedAt            DateTime?               @map("started_at")
  status               RewindSessionStatus     @default(LEGACY)
  completionSource     RewindCompletionSource? @map("completion_source")
  openingAnswered      Boolean?                @default(false) @map("opening_answered")
  currentQuestionIndex Int?                    @default(0) @map("current_question_index")
  completed            Boolean                 @default(false)
  completedAt          DateTime?               @map("completed_at")
  checkInAt            DateTime?               @map("check_in_at")
  responses            Json?
  summary              String?
  emotionalInsight     String?                 @map("emotional_insight")
  emotionalTags        String[]                @default([]) @map("emotional_tags")
  nextStepNote         String?                 @map("next_step_note")
  comparisonInsight    String?                 @map("comparison_insight")
  journalDraft         String?                 @map("journal_draft")
  wellbeingSignals     Json?                   @map("wellbeing_signals")
  transcriptAvailable  Boolean                 @default(false) @map("transcript_available")
  journalId            String?                 @map("journal_id")
  journalSavedAt       DateTime?               @map("journal_saved_at")
  journal              Journal?                @relation(fields: [journalId], references: [id], onDelete: SetNull)
  turns                RewindTurn[]
  recommendations      RewindRecommendation[]

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, scheduledFor])
  @@index([userId, personaId, updatedAt])
  @@index([userId, completed, sessionDateKey])
  @@index([status, windowEndsAt])
  @@index([journalId])
  @@map("rewind_sessions")
}

enum RewindRecommendationType {
  GOAL_PROGRESS
  NEW_GOAL
  FLEXX
}

enum RewindRecommendationStatus {
  PENDING
  ACCEPTED
  DISMISSED
  EXPIRED
}

model RewindRecommendation {
  id        String        @id @default(cuid())
  sessionId String        @map("session_id")
  session   RewindSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String        @map("user_id")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      RewindRecommendationType
  status    RewindRecommendationStatus @default(PENDING)
  title     String
  rationale String                     @db.Text
  payload   Json
  evidence  Json
  dedupeKey String                     @unique @map("dedupe_key")

  resultingGoalId          String?            @unique @map("resulting_goal_id")
  resultingGoal            GoalV2?            @relation("RewindRecommendationGoal", fields: [resultingGoalId], references: [id], onDelete: SetNull)
  resultingProgressEntryId String?            @unique @map("resulting_progress_entry_id")
  resultingProgressEntry   GoalProgressEntry? @relation("RewindRecommendationProgress", fields: [resultingProgressEntryId], references: [id], onDelete: SetNull)

  acceptedAt  DateTime? @map("accepted_at")
  dismissedAt DateTime? @map("dismissed_at")
  expiredAt   DateTime? @map("expired_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([sessionId, status])
  @@index([userId, createdAt])
  @@map("rewind_recommendations")
}

model RewindRoutine {
  id String @id @default(cuid())

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  frequency    RewindFrequency
  times        String[]        @default([])
  intent       RewindIntent
  customIntent String?         @map("custom_intent") @db.Text
  enabled      Boolean         @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("rewind_routines")
}

enum RewindFrequency {
  MORNINGS_AND_EVENINGS
  JUST_MORNINGS
  JUST_EVENINGS
  CUSTOM
}

enum RewindIntent {
  UNDERSTAND_EMOTIONS
  SPOT_PATTERNS
  BUILD_SMALL_CHANGES
  CUSTOM
}

enum RewindSessionStatus {
  LEGACY
  SCHEDULED
  IN_PROGRESS
  FINALIZING
  COMPLETED
  MISSED
}

enum RewindCompletionSource {
  USER
  AUTO_TIMEOUT
}

enum RewindTurnRole {
  USER
  PARTNER
}

model RewindTurn {
  id String @id @default(cuid())

  sessionId String        @map("session_id")
  session   RewindSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  sequence Int            @map("sequence")
  role     RewindTurnRole
  content  String         @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([sessionId, sequence])
  @@index([sessionId, createdAt])
  @@map("rewind_turns")
}

enum RewindChatType {
  GROUP
  PARTNER
}

enum RewindChatMessageRole {
  USER
  PARTNER
  SYSTEM
}

enum RewindChatRunTrigger {
  USER_MESSAGE
  ACTIVITY_SIGNAL
  PARTNER_FOLLOW_UP
  PROACTIVE_TIMER
}

enum RewindChatRunStatus {
  QUEUED
  PLANNING
  GENERATING
  COMPLETED
  CANCELLED
  FAILED
}

enum RewindChatTurnStatus {
  PLANNED
  GENERATING
  COMPLETED
  CANCELLED
  FAILED
}

enum RewindPartnerMindState {
  DORMANT
  WATCHING
  READY
  COOLDOWN
}

model RewindChat {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  threadKey     String              @map("thread_key")
  type          RewindChatType
  personaId     String?             @map("persona_id")
  title         String
  archivedAt    DateTime?           @map("archived_at")
  lastMessageAt DateTime?           @map("last_message_at")
  lastReadAt    DateTime?           @map("last_read_at")
  unreadCount   Int                 @default(0) @map("unread_count")
  proactiveMuted Boolean            @default(false) @map("proactive_muted")
  contextRevision Int               @default(0) @map("context_revision")
  messages      RewindChatMessage[]
  partnerMinds  RewindPartnerMind[]
  runs          RewindChatRun[]
  turns         RewindChatTurn[]
  outbox        RewindChatOutbox[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, threadKey])
  @@index([userId, archivedAt, lastMessageAt])
  @@map("rewind_chats")
}

model RewindChatMessage {
  id String @id @default(cuid())

  chatId String     @map("chat_id")
  chat   RewindChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId String     @map("user_id")
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  role           RewindChatMessageRole
  personaId      String?               @map("persona_id")
  content        String                @db.Text
  localDateKey   String                @map("local_date_key")
  mentions       String[]              @default([])
  idempotencyKey String?               @unique @map("idempotency_key")
  runId          String?               @map("run_id")
  run            RewindChatRun?        @relation(fields: [runId], references: [id], onDelete: SetNull)
  sourceRuns     RewindChatRun[]       @relation("RewindChatRunSourceMessage")
  turnId         String?               @map("turn_id")
  turn           RewindChatTurn?       @relation(fields: [turnId], references: [id], onDelete: SetNull)
  replyToMessageId String?             @map("reply_to_message_id")
  replyToMessage RewindChatMessage?    @relation("RewindChatMessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies        RewindChatMessage[]   @relation("RewindChatMessageReply")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([chatId, createdAt, id])
  @@index([userId, localDateKey, createdAt])
  @@map("rewind_chat_messages")
}

model RewindPartnerMind {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId String @map("chat_id")
  chat   RewindChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  personaId String @map("persona_id")
  state RewindPartnerMindState @default(WATCHING)
  intentSummary String? @map("intent_summary") @db.VarChar(280)
  evidence Json?
  confidence Float?
  contextRevision Int @default(0) @map("context_revision")
  nextConsiderAt DateTime? @map("next_consider_at")
  cooldownUntil DateTime? @map("cooldown_until")
  expiresAt DateTime? @map("expires_at")
  lastEvaluatedAt DateTime? @map("last_evaluated_at")
  lastSpokeAt DateTime? @map("last_spoke_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([chatId, personaId])
  @@index([userId, nextConsiderAt, state])
  @@map("rewind_partner_minds")
}

model RewindChatRun {
  id String @id @default(cuid())

  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId String @map("chat_id")
  chat RewindChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  trigger RewindChatRunTrigger
  status RewindChatRunStatus @default(QUEUED)
  idempotencyKey String @unique @map("idempotency_key")
  sourceMessageId String? @map("source_message_id")
  contextRevision Int @map("context_revision")
  maxTurns Int @default(6) @map("max_turns")
  turnsUsed Int @default(0) @map("turns_used")
  leaseToken String? @map("lease_token")
  leasedAt DateTime? @map("leased_at")
  startedAt DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")
  errorCode String? @map("error_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  sourceMessage RewindChatMessage? @relation("RewindChatRunSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  messages RewindChatMessage[]
  turns RewindChatTurn[]
  aiUsage AiUsageLedger[]

  @@index([userId, status, createdAt])
  @@index([chatId, status, createdAt])
  @@map("rewind_chat_runs")
}

model RewindChatTurn {
  id String @id @default(cuid())

  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId String @map("chat_id")
  chat RewindChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  runId String @map("run_id")
  run RewindChatRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  personaId String @map("persona_id")
  sequence Int
  status RewindChatTurnStatus @default(PLANNED)
  replyToMessageId String? @map("reply_to_message_id")
  firstDeltaAt DateTime? @map("first_delta_at")
  startedAt DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")
  errorCode String? @map("error_code")
  createdAt DateTime @default(now()) @map("created_at")

  messages RewindChatMessage[]
  aiUsage AiUsageLedger[]

  @@unique([runId, sequence])
  @@index([chatId, status, createdAt])
  @@map("rewind_chat_turns")
}

model RewindChatOutbox {
  id String @id @default(cuid())

  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId String @map("chat_id")
  chat RewindChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  eventType String @map("event_type")
  payload Json
  dedupeKey String @unique @map("dedupe_key")
  publishedAt DateTime? @map("published_at")
  attempts Int @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([publishedAt, createdAt])
  @@index([userId, createdAt])
  @@map("rewind_chat_outbox")
}

enum AiUsageOperation {
  REWIND_DIRECTOR
  REWIND_PARTNER_TURN
}

model AiUsageLedger {
  id String @id @default(cuid())

  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  runId String? @map("run_id")
  run RewindChatRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  turnId String? @map("turn_id")
  turn RewindChatTurn? @relation(fields: [turnId], references: [id], onDelete: SetNull)

  provider String
  model String
  operation AiUsageOperation
  inputTokens Int @default(0) @map("input_tokens")
  outputTokens Int @default(0) @map("output_tokens")
  totalTokens Int @default(0) @map("total_tokens")
  inputRateUsdPerMillion Float @map("input_rate_usd_per_million")
  outputRateUsdPerMillion Float @map("output_rate_usd_per_million")
  estimatedCostUsd Float @map("estimated_cost_usd")
  idempotencyKey String @unique @map("idempotency_key")
  metadata Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([runId, createdAt])
  @@index([operation, createdAt])
  @@map("ai_usage_ledger")
}

enum ActivitySignalSourceType {
  ACHIEVEMENT
  FLEXX
  GOAL
  JOURNAL
  REWARD
  REWIND_CHAT
  REWIND_ROUTINE
  REWIND_VOICE
}

model ActivitySignal {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sourceType      ActivitySignalSourceType @map("source_type")
  sourceId        String                   @map("source_id")
  eventType       String                   @map("event_type")
  localDateKey    String                   @map("local_date_key")
  description     String                   @db.Text
  personaId       String?                  @map("persona_id")
  metadata        Json?
  privacyEligible Boolean                  @default(true) @map("privacy_eligible")
  dedupeKey       String                   @unique @map("dedupe_key")
  happenedAt      DateTime                 @map("happened_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, localDateKey, happenedAt])
  @@index([userId, sourceType, happenedAt])
  @@map("activity_signals")
}

model DailyObservation {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  localDateKey      String    @map("local_date_key")
  description       String    @db.Text
  observations      Json
  evidence          Json
  sourceTypes       String[]  @default([]) @map("source_types")
  confidence        Float
  personaId         String?   @map("persona_id")
  homeGreeting      String?   @map("home_greeting")
  reflection        String?   @db.Text
  journalDraft      String?   @map("journal_draft") @db.Text
  generationVersion Int       @default(1) @map("generation_version")
  dismissedAt       DateTime? @map("dismissed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, localDateKey])
  @@index([userId, dismissedAt, localDateKey])
  @@map("daily_observations")
}

model FeatureFlag {
  id String @id @default(cuid())

  key     String  @unique
  enabled Boolean @default(false)

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("feature_flags")
}

model Goal {
  id String @id @default(cuid())

  goalText        String    @map("goal_text")
  targetDays      Int       @map("target_days")
  currentDay      Int       @default(0) @map("current_day")
  lastCheckInDate DateTime? @map("last_check_in_date")
  reminderTime    String?   @map("reminder_time") // Format: "HH:MM" (24-hour format)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  // Community relations
  templateId  String?       @map("template_id")
  template    GoalTemplate? @relation(fields: [templateId], references: [id])
  communityId String?       @map("community_id")
  community   Community?    @relation(fields: [communityId], references: [id])

  checkIns      CheckIn[]
  pendingPoints GoalPendingPoints?

  startedAt         DateTime           @map("started_at")
  archivedAt        DateTime?          @map("archived_at")
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  goalMilestoneHits GoalMilestoneHit[]

  @@index([templateId])
  @@index([communityId])
}

enum GoalV2Status {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
  AUTO_ABANDONED
}

enum GoalTargetType {
  CHECK_IN_COUNT
  QUANTITY
  UNTIL_DATE
}

enum GoalScheduleType {
  ONE_TIME
  DAILY
  WEEKLY
  SELECTED_WEEKDAYS
}

enum GoalMissMode {
  STRICT
  FLEXIBLE
  NO_STREAK
}

enum GoalRewardReleasePolicy {
  IMMEDIATE
  ON_COMPLETION
}

enum GoalOccurrenceStatus {
  PENDING
  GRACE
  COMPLETED
  MISSED
  CANCELLED
}

enum GoalRewardPlanSource {
  STANDARD
  COMMUNITY_TEMPLATE
}

enum GoalRewardAwardStatus {
  PENDING
  RELEASED
  FORFEITED
}

enum GoalResumeDeadlinePolicy {
  KEEP_DEADLINE
  SHIFT_DEADLINE
}

model GoalV2 {
  id          String       @id @default(cuid())
  userId      String       @map("user_id")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?      @db.Text
  status      GoalV2Status @default(ACTIVE)

  targetType  GoalTargetType @map("target_type")
  targetValue Float?         @map("target_value")
  unit        String?

  scheduleType  GoalScheduleType @map("schedule_type")
  weekdays      Int[]            @default([])
  startDate     DateTime         @map("start_date") @db.Date
  endDate       DateTime?        @map("end_date") @db.Date
  hardStopDate  DateTime         @map("hard_stop_date") @db.Date
  reminderTimes String[]         @default([]) @map("reminder_times")

  missMode             GoalMissMode @default(STRICT) @map("miss_mode")
  graceHours           Int          @default(0) @map("grace_hours")
  breakStreakOnMiss    Boolean      @default(true) @map("break_streak_on_miss")
  forfeitPendingOnMiss Boolean      @default(true) @map("forfeit_pending_on_miss")
  maxConsecutiveMisses Int?         @map("max_consecutive_misses")

  rewardReleasePolicy GoalRewardReleasePolicy @default(ON_COMPLETION) @map("reward_release_policy")

  progressValue        Float @default(0) @map("progress_value")
  completedOccurrences Int   @default(0) @map("completed_occurrences")
  missedOccurrences    Int   @default(0) @map("missed_occurrences")
  currentStreak        Int   @default(0) @map("current_streak")
  longestStreak        Int   @default(0) @map("longest_streak")
  consecutiveMisses    Int   @default(0) @map("consecutive_misses")

  communityId String?       @map("community_id")
  community   Community?    @relation(fields: [communityId], references: [id], onDelete: SetNull)
  templateId  String?       @map("template_id")
  template    GoalTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  reopenedFromId String?  @map("reopened_from_id")
  reopenedFrom   GoalV2?  @relation("GoalV2Reopens", fields: [reopenedFromId], references: [id], onDelete: SetNull)
  reopenedGoals  GoalV2[] @relation("GoalV2Reopens")

  occurrences          GoalOccurrence[]
  rewardPlan           GoalRewardPlan?
  conclusion           GoalConclusion?
  pauses               GoalPause[]
  sourceRecommendation RewindRecommendation? @relation("RewindRecommendationGoal")

  pausedAt    DateTime? @map("paused_at")
  completedAt DateTime? @map("completed_at")
  abandonedAt DateTime? @map("abandoned_at")
  archivedAt  DateTime? @map("archived_at")
  startedAt   DateTime  @default(now()) @map("started_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([userId, status, archivedAt])
  @@index([status, hardStopDate])
  @@index([communityId])
  @@index([templateId])
  @@map("goals_v2")
}

model GoalOccurrence {
  id              String               @id @default(cuid())
  goalId          String               @map("goal_id")
  goal            GoalV2               @relation(fields: [goalId], references: [id], onDelete: Cascade)
  status          GoalOccurrenceStatus @default(PENDING)
  dueDate         DateTime             @map("due_date") @db.Date
  originalDueDate DateTime             @map("original_due_date") @db.Date
  closesAt        DateTime             @map("closes_at")
  graceEndsAt     DateTime?            @map("grace_ends_at")
  rescheduledAt   DateTime?            @map("rescheduled_at")
  completedAt     DateTime?            @map("completed_at")
  progress        GoalProgressEntry?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([goalId, dueDate])
  @@index([status, closesAt])
  @@index([goalId, dueDate])
  @@map("goal_occurrences")
}

model GoalProgressEntry {
  id                   String                @id @default(cuid())
  occurrenceId         String                @unique @map("occurrence_id")
  occurrence           GoalOccurrence        @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  amount               Float                 @default(1)
  notes                String?               @db.Text
  attachments          Json?
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at")
  sourceRecommendation RewindRecommendation? @relation("RewindRecommendationProgress")

  @@map("goal_progress_entries")
}

model GoalRewardPlan {
  id             String                  @id @default(cuid())
  goalId         String                  @unique @map("goal_id")
  goal           GoalV2                  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  source         GoalRewardPlanSource
  releasePolicy  GoalRewardReleasePolicy @map("release_policy")
  eligible       Boolean                 @default(false)
  eligibleAt     DateTime?               @map("eligible_at")
  totalPotential Float                   @default(0) @map("total_potential")
  milestones     GoalRewardMilestone[]
  awards         GoalRewardAward[]
  createdAt      DateTime                @default(now()) @map("created_at")

  @@map("goal_reward_plans")
}

model GoalRewardMilestone {
  id                String            @id @default(cuid())
  rewardPlanId      String            @map("reward_plan_id")
  rewardPlan        GoalRewardPlan    @relation(fields: [rewardPlanId], references: [id], onDelete: Cascade)
  name              String
  triggerPercentage Int               @map("trigger_percentage")
  points            Float
  order             Int
  awards            GoalRewardAward[]

  @@unique([rewardPlanId, triggerPercentage])
  @@index([rewardPlanId, order])
  @@map("goal_reward_milestones")
}

model GoalRewardAward {
  id             String                @id @default(cuid())
  goalId         String                @map("goal_id")
  planId         String?               @map("plan_id")
  plan           GoalRewardPlan?       @relation(fields: [planId], references: [id], onDelete: SetNull)
  milestoneId    String?               @map("milestone_id")
  milestone      GoalRewardMilestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  referenceTitle String                @map("reference_title")
  referenceType  String                @default("GOAL_V2") @map("reference_type")
  points         Float
  status         GoalRewardAwardStatus
  dedupeKey      String                @unique @map("dedupe_key")
  transactionId  String?               @map("transaction_id")
  awardedAt      DateTime              @default(now()) @map("awarded_at")
  releasedAt     DateTime?             @map("released_at")
  forfeitedAt    DateTime?             @map("forfeited_at")

  @@unique([goalId, milestoneId])
  @@index([goalId, status])
  @@map("goal_reward_awards")
}

model GoalConclusion {
  id                   String       @id @default(cuid())
  goalId               String       @unique @map("goal_id")
  goal                 GoalV2       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  outcome              GoalV2Status
  finalProgress        Float        @map("final_progress")
  targetValue          Float?       @map("target_value")
  adherenceRate        Float        @map("adherence_rate")
  completedOccurrences Int          @map("completed_occurrences")
  missedOccurrences    Int          @map("missed_occurrences")
  currentStreak        Int          @map("current_streak")
  longestStreak        Int          @map("longest_streak")
  durationDays         Int          @map("duration_days")
  overTargetAmount     Float        @default(0) @map("over_target_amount")
  earnedPoints         Float        @default(0) @map("earned_points")
  releasedPoints       Float        @default(0) @map("released_points")
  forfeitedPoints      Float        @default(0) @map("forfeited_points")
  rating               Int?
  reflection           String?      @db.Text
  nextStep             String?      @map("next_step") @db.Text
  attachments          Json?
  endedAt              DateTime     @map("ended_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  reviewUpdatedAt      DateTime?    @map("review_updated_at")

  @@map("goal_conclusions")
}

model GoalPause {
  id             String                    @id @default(cuid())
  goalId         String                    @map("goal_id")
  goal           GoalV2                    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  pausedAt       DateTime                  @map("paused_at")
  resumedAt      DateTime?                 @map("resumed_at")
  deadlinePolicy GoalResumeDeadlinePolicy? @map("deadline_policy")

  @@index([goalId, pausedAt])
  @@map("goal_pauses")
}

model CheckIn {
  id String @id @default(cuid())

  goalId String @map("goal_id")
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  checkInDate DateTime @map("check_in_date")
  notes       String?  @db.Text // Optional notes for the check-in
  attachments String? // JSON array of attachments: [{type: 'image'|'audio', url: string, publicId?: string, name?: string}]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([goalId, checkInDate])
  @@map("check_ins")
}

model Notification {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goalId String? @map("goal_id")

  type      String // "goal_reminder", "goal_completed", "streak_milestone", "system"
  title     String
  message   String
  data      String? // JSON string for additional data
  dedupeKey String? @map("dedupe_key")

  isRead Boolean @default(false) @map("is_read")

  scheduledFor     DateTime? @map("scheduled_for") // When the notification should be sent
  sentAt           DateTime? @map("sent_at") // When the notification was actually sent
  dispatchToken    String?   @map("dispatch_token")
  dispatchingAt    DateTime? @map("dispatching_at")
  deliveryAttempts Int       @default(0) @map("delivery_attempts")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, dedupeKey])
  @@index([userId, isRead])
  @@index([scheduledFor])
  @@index([dispatchToken])
  @@index([sentAt, scheduledFor, dispatchingAt])
  @@map("notifications")
}

model Achievement {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goalId String? @map("goal_id")

  type        String // "streak_milestone", "goal_completed", "total_goals", "total_checkins", "perfect_week", "comeback", "early_bird"
  milestone   Int // Day number or count (3, 7, 14, 21, 30, 50, 100, 365)
  title       String // "Adventurous Streaker", "Consistency Champion"
  description String // "Reached 10 consecutive days"
  badgeIcon   String @map("badge_icon") // Emoji or icon identifier

  earnedAt DateTime @default(now()) @map("earned_at")

  @@unique([userId, type, milestone])
  @@index([userId])
  @@map("achievements")
}

model ChillSession {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emotion         String // User's emotional input
  duration        Int // Session duration in minutes
  completed       Boolean   @default(false)
  completedAt     DateTime? @map("completed_at")
  postSessionMood String?   @map("post_session_mood") // How user felt after session

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([completed, completedAt])
  @@map("chill_sessions")
}

model Journal {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date           DateTime // Date of the journal entry (date only, no time)
  content        String          @db.Text // Journal entry text
  mood           String? // Mood/emotion tag (e.g., "happy", "anxious", "calm")
  tags           String[]        @default([]) // Additional tags
  rewindSessions RewindSession[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@index([userId, date])
  @@map("journals")
}

enum CommunityMemberRole {
  OWNER
  MOD
  MEMBER
}

enum CommunityActivityType {
  GOAL_STARTED
  GOAL_CHECK_IN
  GOAL_COMPLETED
  GOAL_STREAK_RESET
  GOAL_DELETED
  MEMBER_LEFT
  MILESTONE_REACHED
  ACHIEVEMENT_EARNED
  TEMPLATE_CREATED
}

model Community {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  coverImage  String? @map("cover_image")
  isPublic    Boolean @default(false) @map("is_public") // Communities are invite-only by default
  category    String?

  ownerId String @map("owner_id")
  owner   User   @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members       CommunityMember[]
  templates     GoalTemplate[]
  activities    CommunityActivity[]
  goals         Goal[]
  standardGoals GoalV2[]
  invites       CommunityInvite[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([isPublic, createdAt])
  @@map("communities")
}

model CommunityInvite {
  id          String    @id @default(cuid())
  communityId String    @map("community_id")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  code      String @unique // Short shareable code e.g. "A3K9F2"
  createdBy String @map("created_by")
  creator   User   @relation("InviteCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  // For targeted invites
  inviteeEmail    String? @map("invitee_email")
  inviteeUsername String? @map("invitee_username")
  inviteeUserId   String? @map("invitee_user_id")
  invitee         User?   @relation("InviteRecipient", fields: [inviteeUserId], references: [id], onDelete: SetNull)

  maxUses   Int       @default(-1) @map("max_uses") // -1 = unlimited
  uses      Int       @default(0)
  expiresAt DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([communityId])
  @@index([code])
  @@index([inviteeUserId])
  @@map("community_invites")
}

model CommunityMember {
  id          String    @id @default(cuid())
  communityId String    @map("community_id")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  role CommunityMemberRole @default(MEMBER)

  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([communityId, userId])
  @@index([userId])
  @@index([communityId])
  @@map("community_members")
}

model GoalTemplate {
  id          String    @id @default(cuid())
  communityId String    @map("community_id")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  goalText     String? @map("goal_text") // Aligned with Goal model
  targetDays   Int     @map("target_days")
  reminderTime String? @map("reminder_time") // Format: "HH:MM" (24-hour format)

  modelVersion  Int              @default(2) @map("model_version")
  targetType    GoalTargetType   @default(CHECK_IN_COUNT) @map("target_type")
  targetValue   Float?           @map("target_value")
  unit          String?
  scheduleType  GoalScheduleType @default(DAILY) @map("schedule_type")
  weekdays      Int[]            @default([])
  reminderTimes String[]         @default([]) @map("reminder_times")

  createdBy String @map("created_by")
  creator   User   @relation("TemplateCreator", fields: [createdBy], references: [id])

  startedGoals  Goal[]
  standardGoals GoalV2[]
  milestones    TemplateMilestone[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([communityId])
  @@index([createdBy])
  @@map("goal_templates")
}

enum MilestoneTriggerType {
  DAY
  PERCENTAGE
  SEQUENCE
}

model TemplateMilestone {
  id                  String               @id @default(cuid())
  templateId          String               @map("template_id")
  template            GoalTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  triggerType         MilestoneTriggerType @map("trigger_type")
  triggerValue        Int                  @map("trigger_value")
  points              Float                @default(0)
  sequenceBonusPoints Float                @default(10) @map("sequence_bonus_points")
  sequenceStartDay    Int?                 @map("sequence_start_day")
  sequenceEndDay      Int?                 @map("sequence_end_day")
  order               Int                  @default(0)

  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at")
  goalMilestoneHits GoalMilestoneHit[]

  @@index([templateId, order])
  @@map("template_milestones")
}

model GoalMilestoneHit {
  id            String            @id @default(cuid())
  goalId        String            @map("goal_id")
  goal          Goal              @relation(fields: [goalId], references: [id], onDelete: Cascade)
  milestoneId   String            @map("milestone_id")
  milestone     TemplateMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  sequenceValue Int               @default(0) @map("sequence_value")
  pointsAwarded Float             @default(0) @map("points_awarded")
  awardedAt     DateTime          @default(now()) @map("awarded_at")

  @@unique([goalId, milestoneId, sequenceValue])
  @@index([goalId])
  @@index([milestoneId])
  @@map("goal_milestone_hits")
}

model CommunityActivity {
  id          String    @id @default(cuid())
  communityId String    @map("community_id")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     CommunityActivityType
  goalId   String?               @map("goal_id")
  metadata String?               @db.Text // JSON string for additional data

  reactions ActivityReaction[]
  comments  ActivityComment[]
  reports   ContentReport[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([communityId, createdAt])
  @@index([userId])
  @@index([goalId])
  @@map("community_activities")
}

model ServerMetric {
  id String @id @default(cuid())

  name  String
  tags  String[] @default([])
  value Float

  createdAt DateTime @default(now()) @map("created_at")

  @@index([name, createdAt])
  @@map("server_metrics")
}

model ActivityReaction {
  id         String            @id @default(cuid())
  activityId String            @map("activity_id")
  activity   CommunityActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String            @map("user_id")
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([activityId, userId])
  @@index([activityId])
  @@index([userId])
  @@map("activity_reactions")
}

model ActivityComment {
  id         String            @id @default(cuid())
  activityId String            @map("activity_id")
  activity   CommunityActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String            @map("user_id")
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  text String @db.Text

  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at")
  reports   ContentReport[]

  @@index([activityId])
  @@index([userId])
  @@map("activity_comments")
}

enum ModerationReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  blocker   User     @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model ContentReport {
  id           String                 @id @default(cuid())
  reporterId   String                 @map("reporter_id")
  targetUserId String                 @map("target_user_id")
  activityId   String?                @map("activity_id")
  commentId    String?                @map("comment_id")
  reason       String
  details      String?                @db.Text
  status       ModerationReportStatus @default(OPEN)
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @default(now()) @updatedAt @map("updated_at")

  reporter   User               @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser User               @relation("ReportsAgainst", fields: [targetUserId], references: [id], onDelete: Cascade)
  activity   CommunityActivity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  comment    ActivityComment?   @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetUserId, status])
  @@index([activityId])
  @@index([commentId])
  @@map("content_reports")
}

model GoalPendingPoints {
  id     String @id @default(cuid())
  goalId String @unique @map("goal_id")
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  totalPendingPoints Float @default(0) @map("total_pending_points") // Sum of all milestone points earned but not yet released

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("goal_pending_points")
}

enum TransactionType {
  BUY_POINTS
  WITHDRAW_POINTS
  FEE_TRANSFER
  REWARD_POINTS
  MANUAL_ADJUSTMENT
}

model Transaction {
  id String @id @default(cuid())

  type       TransactionType
  amount     Float // Amount in points
  fiatAmount Float? // Optional: Amount in USD/Fiat

  senderId String? @map("sender_id")
  sender   User?   @relation("TransactionSender", fields: [senderId], references: [id])

  recipientId String @map("recipient_id")
  recipient   User   @relation("TransactionRecipient", fields: [recipientId], references: [id])

  referenceId String? @map("reference_id") // MoonPay transaction ID or Goal ID
  dedupeKey   String? @unique @map("dedupe_key")
  metadata    String? @db.Text // JSON string for additional details

  status String @default("PENDING") // PENDING, COMPLETED, FAILED

  createdAt DateTime @default(now()) @map("created_at")

  @@index([senderId])
  @@index([recipientId])
  @@index([recipientId, createdAt, id], map: "transactions_recipient_created_id_idx")
  @@index([senderId, createdAt, id], map: "transactions_sender_created_id_idx")
  @@index([type])
  @@map("transactions")
}

model SystemConfig {
  id String @id @default(cuid())

  key   String @unique
  value String

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_configs")
}
